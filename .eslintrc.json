{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "no-alert": "error",
    "eqeqeq": "error",
    "prefer-const": "error",
    "@typescript-eslint/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "webpack.config.js"
  ]
}